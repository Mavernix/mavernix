# Where the desktop's files are installed; generated by meson and sourced
# by the session's shell scripts (paths.py.in is the Python twin).

# Compiled parts and the session's own scripts.
library_dir=@LIBRARY_DIR@
# Everything that is read, not run: the shell's QML, configs, themes, sounds.
data_dir=@DATA_DIR@

session_dir=$library_dir/session
program_dir=$library_dir/bin
compositor_plugin_dir=$library_dir/wayfire
qml_module_dir=$library_dir/qml

shell_dir=$data_dir/shell
config_dir=$data_dir/config
# Desktops the Theme Installer added, for this user only.
user_config_dir=${XDG_DATA_HOME:-$HOME/.local/share}/mavernix/config

# Prints the config file of the desktop called NAME, the user's own first;
# fails if there is none: find_desktop_config NAME
find_desktop_config() {
    local folder
    for folder in "$user_config_dir" "$config_dir"; do
        if [[ -f "$folder/$1.toml" ]]; then
            echo "$folder/$1.toml"
            return 0
        fi
    done
    return 1
}
compositor_metadata_dir=$data_dir/wayfire
