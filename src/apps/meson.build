# The desktop's own programs. Each is installed into PREFIX/lib/mavernix/bin,
# which the session puts on the PATH; those with a Qt Quick interface read
# their QML from PREFIX/share/mavernix/apps/NAME/qml.

mavernix_bindir = mavernix_libdir / 'bin'

subdir('theme-installer')
subdir('settings')
subdir('about')
