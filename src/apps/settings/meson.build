# The settings window, made of Qt's ordinary widgets. It draws nothing itself:
# the session makes Qt programs follow the desktop's theme.

moc_sources = qt.compile_moc(
    headers: ['settings-window.hpp', 'overview.hpp', 'dock-pane.hpp', 'desktop-pane.hpp', 'theme-pane.hpp', 'sound-pane.hpp',
        'trackpad-pane.hpp', 'mouse-pane.hpp', 'picture-chooser.hpp', 'energy-pane.hpp', 'display-pane.hpp',
        'desktops-pane.hpp', 'windows-pane.hpp', 'toolkits-pane.hpp', 'extensions-pane.hpp', 'source-list-delegate.hpp', 'bluetooth-pane.hpp',
        'icons-pane.hpp', 'keyboard-pane.hpp', 'defaults-pane.hpp', 'shortcut-editor.hpp', 'program-shortcut-dialog.hpp',
        'shortcut-recorder.hpp', 'compositor-link.hpp', 'input-sources-pane.hpp', 'icon-chooser.hpp', 'startup-pane.hpp', 'display-modes.hpp'],
    dependencies: qt_widgets,
)

executable(
    'mavernix-settings',
    [
        'main.cpp',
        'choices.cpp',
        'settings-window.cpp',
        'overview.cpp',
        'dock-pane.cpp',
        'desktop-pane.cpp',
        'theme-pane.cpp',
        'sound-pane.cpp',
        'trackpad-pane.cpp',
        'mouse-pane.cpp',
        'picture-chooser.cpp',
        'energy-pane.cpp',
        'display-pane.cpp',
        'panel-modes.cpp',
        'desktops-pane.cpp',
        'windows-pane.cpp',
        'toolkits-pane.cpp',
        'extensions-pane.cpp',
        'source-list-delegate.cpp',
        'bluetooth-pane.cpp',
        'icons-pane.cpp',
        'icon-chooser.cpp',
        'icon-theme-names.cpp',
        'installed-applications.cpp',
        'sound-devices.cpp',
        'pane-parts.cpp',
        'keyboard-pane.cpp',
        'defaults-pane.cpp',
        'installed-programs.cpp',
        'shortcut-editor.cpp',
        'shortcut-keys.cpp',
        'shortcut-recorder.cpp',
        'compositor-link.cpp',
        'program-shortcut-dialog.cpp',
        'input-sources-pane.cpp',
        'keyboard-layouts.cpp',
        'startup-pane.cpp',
        'startup-entries.cpp',
        'display-modes.cpp',
        'compositor-call.cpp',
        moc_sources,
    ],
    dependencies: [qt_widgets, gio],
    install: true,
    install_dir: mavernix_bindir,
)
